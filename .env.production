# Environment: Production
# Description: Environment variables for production environment
# Note: Do not commit sensitive information to version control
VITE_LEARNING_PLATFORM_API_URL="https://electrolink-backend.onrender.com/api/v1"

# IAM
VITE_SIGNUP_ENDPOINT_PATH="/authentication/sign-up"
VITE_SIGNIN_ENDPOINT_PATH="/authentication/sign-in"
VITE_USERS_ENDPOINT_PATH="/users"

# PROFILES
VITE_COMPLETE_PROFILE_AS_TECHNICIAN="/profiles/me/complete/technician"
VITE_COMPLETE_PROFILE_AS_HOMEOWNER="/profiles/me/complete/homeowner"
VITE_GET_PROFILE_STATUS="/profiles/me/status"

# ASSETS
VITE_COMPONENT_TYPES_ENDPOINT_PATH="/component-types"
