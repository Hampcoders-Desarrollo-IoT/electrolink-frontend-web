VITE_TECHNICIAN_INVENTORY_ENDPOINT_PATH="/inventory"
VITE_PROPERTIES_ENDPOINT_PATH="/properties"
VITE_PROPERTY_PORTFOLIO_ENDPOINT_PATH="/property-portfolios"

# SHARED
VITE_HOMEOWNERS_ENDPOINT_PATH="/homeowners"
VITE_TECHNICIANS_ENDPOINT_PATH="/technicians"