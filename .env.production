# Environment: Production
# Description: Environment variables for production environment
# Note: Do not commit sensitive information to version control
VITE_ELECTROLINK_PLATFORM_API_URL="https://electrolink-backend.onrender.com/api/v1"

# IAM
VITE_SIGNUP_ENDPOINT_PATH="/authentication/sign-up"
VITE_SIGNIN_ENDPOINT_PATH="/authentication/sign-in"
VITE_USERS_ENDPOINT_PATH="/users"
VITE_REFRESH_CLAIMS_ENDPOINT_PATH="/authentication/refresh-claims"

# PROFILES
VITE_GET_MY_PROFILE="/profiles/me"
VITE_COMPLETE_PROFILE_AS_TECHNICIAN="/profiles/me/complete/technician"
VITE_COMPLETE_PROFILE_AS_HOMEOWNER="/profiles/me/complete/homeowner"
VITE_COMPLETE_PROFILE_AS_COMPANY="/profiles/me/complete/company"
VITE_GET_PROFILE_STATUS="/profiles/me/status"
VITE_PATCH_PERSONAL_DATA="/profiles/me/personal-data"
VITE_PATCH_TECHNICIAN_DATA="/profiles/me/technician"
VITE_PATCH_HOMEOWNER_DATA="/profiles/me/homeowner"
VITE_DEACTIVATE_PROFILE="/profiles/me/deactivate"
VITE_REACTIVATE_PROFILE="/profiles/me/reactivate"

# ASSETS
VITE_COMPONENT_TYPES_ENDPOINT_PATH="/component-types"
VITE_COMPONENTS_ENDPOINT_PATH="/components"
VITE_TECHNICIAN_INVENTORY_ENDPOINT_PATH="/inventory"
VITE_PROPERTIES_ENDPOINT_PATH="/properties"
VITE_PROPERTY_PORTFOLIO_ENDPOINT_PATH="/property-portfolios"

# SHARED
VITE_HOMEOWNERS_ENDPOINT_PATH="/homeowners"
VITE_TECHNICIANS_ENDPOINT_PATH="/technicians"
